# CobaltGraph .gitignore
# Security-focused network monitoring tool

# ======================
# SENSITIVE DATA - CRITICAL
# ======================

# Database files (may contain captured network data)
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.backup
database/

# Sensitive configuration files
config/auth.conf
config/threat_intel.conf
config/database.conf

# TLS/HTTPS certificate and private key files (generated at runtime)
config/server.crt
config/server.key
config/*.pem
*.crt
*.key

# Runtime data (database files, logs in data directory)
data/*.db
data/**/*.db
data/*.db-shm
data/*.db-wal
data/logs/
data/exports/*
!data/exports/.gitkeep

# Screenshot and image captures (may contain hostname/UI info)
data/*.jpg
data/*.jpeg
data/*.png
data/*.gif
data/*.bmp
data/*.webp

# Threat intelligence and MAC vendor data (operational intel, not source)
data/ioc/
data/oui/

# Logs directory
logs/
*.log

# Exports (may contain IP addresses, network data)
exports/
*.csv

# JSON exports (but allow test fixtures)
*.json
!tests/fixtures/*.json

# Allow template configs
!config/*.conf.template

# ======================
# STANDARD IGNORES
# ======================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
/tmp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Documentation (auto-generated markdown)
docs/
*.md
# Allow the public-facing README at repo root
!README.md

# Other directories that should not be tracked
security/
scripts/
static/

# Security tooling (capture scripts, analysis tools — operational, not source)
tools/

# ML model state files (may encode patterns from real captured traffic)
models/
