def _find_venv_python():
    """
    Find virtualenv Python executable relative to this script.

    Cross-platform support:
    - Unix/Linux/macOS: venv/bin/python3, .venv/bin/python3
    - Windows: venv\\Scripts\\python.exe, .venv\\Scripts\\python.exe

    Returns:
        str: Path to venv Python executable, or None if not found
    """
    script_dir = os.path.dirname(os.path.abspath(__file__))

    # Determine OS-specific paths
    if sys.platform == 'win32':
        # Windows uses Scripts\python.exe
        candidates = [
            os.path.join(script_dir, "venv", "Scripts", "python.exe"),
            os.path.join(script_dir, ".venv", "Scripts", "python.exe"),
            os.path.join(script_dir, "venv", "Scripts", "python"),
            os.path.join(script_dir, ".venv", "Scripts", "python"),
        ]
    else:
        # Unix/Linux/macOS use bin/python3
        candidates = [
            os.path.join(script_dir, "venv", "bin", "python3"),
            os.path.join(script_dir, ".venv", "bin", "python3"),
            os.path.join(script_dir, "venv", "bin", "python"),
            os.path.join(script_dir, ".venv", "bin", "python"),
        ]

    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate

    return None


def _is_running_in_venv():
    """Check if we're already running inside a virtualenv."""
    return (
        hasattr(sys, 'real_prefix') or  # virtualenv
        (hasattr(sys, 'base_prefix') and sys.base_prefix != sys.prefix)  # venv
    )


def _bootstrap_venv():
    """
    ENFORCE venv execution with detailed user guidance.

    This function implements strict venv enforcement with step-by-step instructions.

    Security rationale:
    - System Python may have conflicting package versions
    - Prevents dependency pollution and version conflicts
    - Ensures reproducible execution environment
    - Protects against supply chain attacks via isolated packages

    Exit codes:
        1: Venv not found or not activated
    """
    if _is_running_in_venv():
        return  # Already in venv, continue

    venv_python = _find_venv_python()
    if venv_python:
        # Re-exec this script with venv Python
        os.execv(venv_python, [venv_python] + sys.argv)

