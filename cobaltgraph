def _run_dependency_validation(mode='device') -> bool:
    """
    Wrapper for standalone dependency validator.

    This function calls the modular dependency validator from
    src/core/dependency_validator.py which handles all validation logic.

    Args:
        mode: Operating mode ('device' or 'network')

    Returns:
        bool: True if all critical dependencies are satisfied
    """
