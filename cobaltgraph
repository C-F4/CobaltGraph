    critical_missing = missing_packages['missing_critical']
    critical_outdated = missing_packages['outdated_critical']
    critical_invalid = missing_packages['invalid_critical']

    optional_missing = missing_packages['missing_optional']
    optional_outdated = missing_packages['outdated_optional']

    total_issues = (len(critical_missing) + len(critical_outdated) +
                   len(critical_invalid) + len(optional_missing) + len(optional_outdated))

    if total_issues == 0:
