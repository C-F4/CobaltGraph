CobaltGraph - Network Intelligence Platform
Single-file executable with venv auto-activation

Usage:
    ./cobaltgraph                     # Interactive mode
    ./cobaltgraph --mode device       # Device-only monitoring
    sudo ./cobaltgraph --mode network # Network-wide monitoring
    ./cobaltgraph --health            # Run health check
"""

import os
import sys

# ============================================================================
# VENV BOOTSTRAP - Re-exec under venv Python if available
# ============================================================================

def _find_venv_python():
    """
    Find virtualenv Python executable relative to this script.

    Cross-platform support:
    - Unix/Linux/macOS: venv/bin/python3, .venv/bin/python3
    - Windows: venv\\Scripts\\python.exe, .venv\\Scripts\\python.exe

    Returns:
        str: Path to venv Python executable, or None if not found
    """
    script_dir = os.path.dirname(os.path.abspath(__file__))

    # Determine OS-specific paths
    if sys.platform == 'win32':
        # Windows uses Scripts\python.exe
        candidates = [
            os.path.join(script_dir, "venv", "Scripts", "python.exe"),
            os.path.join(script_dir, ".venv", "Scripts", "python.exe"),
            os.path.join(script_dir, "venv", "Scripts", "python"),
            os.path.join(script_dir, ".venv", "Scripts", "python"),
        ]
    else:
        # Unix/Linux/macOS use bin/python3
        candidates = [
            os.path.join(script_dir, "venv", "bin", "python3"),
            os.path.join(script_dir, ".venv", "bin", "python3"),
            os.path.join(script_dir, "venv", "bin", "python"),
            os.path.join(script_dir, ".venv", "bin", "python"),
        ]

    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate

    return None


def _is_running_in_venv():
    """Check if we're already running inside a virtualenv."""
    return (
        hasattr(sys, 'real_prefix') or  # virtualenv
        (hasattr(sys, 'base_prefix') and sys.base_prefix != sys.prefix)  # venv
    )


def _bootstrap_venv():
    """
    ENFORCE venv execution with detailed user guidance.

    This function implements strict venv enforcement with step-by-step instructions.

    Security rationale:
    - System Python may have conflicting package versions
    - Prevents dependency pollution and version conflicts
    - Ensures reproducible execution environment
    - Protects against supply chain attacks via isolated packages

    Exit codes:
        1: Venv not found or not activated
    """
    if _is_running_in_venv():
        return  # Already in venv, continue

    venv_python = _find_venv_python()
    if venv_python:
        # Re-exec this script with venv Python
        os.execv(venv_python, [venv_python] + sys.argv)

    # CRITICAL: No venv found - BLOCK with comprehensive guidance
    # Define Colors inline since main Colors class not loaded yet
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    CYAN = '\033[0;36m'
    BOLD = '\033[1m'
    DIM = '\033[2m'
    NC = '\033[0m'

    print(f"\n{RED}╔══════════════════════════════════════════════════════════════════╗{NC}")
    print(f"{RED}║  ERROR: VIRTUAL ENVIRONMENT REQUIRED                             ║{NC}")
    print(f"{RED}╚══════════════════════════════════════════════════════════════════╝{NC}\n")

    print(f"{YELLOW}Why is a virtual environment required?{NC}")
    print(f"{DIM}  • Isolates CobaltGraph dependencies from system Python{NC}")
    print(f"{DIM}  • Prevents version conflicts with other Python applications{NC}")
    print(f"{DIM}  • Ensures package integrity through hash validation{NC}")
    print(f"{DIM}  • Provides consistent execution environment across systems{NC}\n")

    print(f"{CYAN}Step 1: Create Virtual Environment{NC}")
    print(f"{BOLD}  python3 -m venv venv{NC}")
    print(f"{DIM}  This creates a new virtual environment in the 'venv' directory.{NC}\n")

    print(f"{CYAN}Step 2: Activate Virtual Environment{NC}")

    # Platform-specific activation instructions
    if sys.platform == 'win32':
        print(f"{BOLD}  venv\\Scripts\\activate{NC}")
        print(f"{DIM}  (PowerShell: venv\\Scripts\\Activate.ps1){NC}")
    else:
        print(f"{BOLD}  source venv/bin/activate{NC}")

    print(f"{DIM}  Your prompt will change to show '(venv)' when activated.{NC}\n")

    print(f"{CYAN}Step 3: Install Dependencies{NC}")
    print(f"{BOLD}  pip3 install -r requirements.txt{NC}")
    print(f"{DIM}  This installs all required packages with integrity verification.{NC}\n")

    print(f"{CYAN}Step 4: Launch CobaltGraph{NC}")
    print(f"{BOLD}  ./cobaltgraph{NC}")
    print(f"{DIM}  The launcher will auto-detect the venv and proceed.{NC}\n")

    print(f"{YELLOW}Need help? Visit: https://github.com/C-F4/CobaltGraph/wiki/Setup{NC}\n")

    sys.exit(1)


_bootstrap_venv()

