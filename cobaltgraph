def _parse_requirements_txt(requirements_path=None):
    """
    Parse requirements.txt and extract package specifications.

    Supports:
    - Simple packages: requests>=2.32.3
    - Comments (ignored)
    - Blank lines (ignored)
    - Optional packages detected via section header markers

    Args:
        requirements_path (str): Path to requirements.txt (default: ./requirements.txt)

    Returns:
        dict: {
            'critical': [('package_name', 'version_spec', 'operator'), ...],
            'optional': [('package_name', 'version_spec', 'operator'), ...]
        }
    """
    import re
    from pathlib import Path

    if requirements_path is None:
        script_dir = Path(__file__).resolve().parent
        requirements_path = script_dir / "requirements.txt"
    else:
        requirements_path = Path(requirements_path)

    if not requirements_path.exists():
        return {'critical': [], 'optional': []}

    critical_packages = []
    optional_packages = []
    current_section = 'critical'  # Default to critical

    # Regex to match: package>=version or package==version
    package_regex = re.compile(r'^([a-zA-Z0-9\-_]+)\s*([><=!]+)\s*([0-9\.]+(?:\.dev[0-9]+)?)')

    # More precise section header detection - only match lines that are SECTION HEADERS
    # Format: "# SECTION_NAME (Optional)" or "# SECTION_NAME (Development)" etc.
    section_header_regex = re.compile(r'^#\s+[A-Z\s]+\((?:Optional|Development|Visualization)', re.IGNORECASE)

    try:
        with open(requirements_path, 'r') as f:
            for line in f:
                line_stripped = line.strip()

                # Detect section headers for optional packages using precise pattern
                # Only trigger on actual section headers like "# GEOLOCATION (Optional but Recommended)"
                if section_header_regex.match(line_stripped):
                    upper_line = line_stripped.upper()
                    if 'OPTIONAL' in upper_line or 'DEVELOPMENT' in upper_line or 'VISUALIZATION' in upper_line:
                        current_section = 'optional'
                        continue

                # Skip comments and blank lines
                if not line_stripped or line_stripped.startswith('#'):
                    continue

                # Parse package specification
                match = package_regex.match(line_stripped)
                if match:
                    package_name = match.group(1).lower()  # Normalize to lowercase
                    operator = match.group(2)
                    version_spec = match.group(3)

                    entry = (package_name, version_spec, operator)

                    if current_section == 'critical':
                        critical_packages.append(entry)
                    else:
                        optional_packages.append(entry)
    except Exception:
        pass  # Gracefully handle file read errors

    return {
        'critical': critical_packages,
        'optional': optional_packages
    }


def _check_package_integrity(package_name, installed_version, expected_version, operator):
    """
    Verify package version (LOOSENED MODE - hash warnings only).

    Validation steps:
    1. Check version meets minimum requirement
    2. Warn about hash mismatches (doesn't block)

    Args:
        package_name (str): Package name (lowercase)
        installed_version (str): Installed version string
        expected_version (str): Required minimum version
        operator (str): Version operator (>=, ==, >, <, etc.)

    Returns:
        tuple: (is_valid: bool, warning_message: str or None)
    """
    # Version comparison without importing packaging (simpler approach)
    def parse_version(ver_string):
        """Simple version parser for common formats like '2.3.5'"""
        try:
            return tuple(int(x) for x in ver_string.split('.'))
        except:
            return (0,)

    try:
        installed_ver = parse_version(installed_version)
        expected_ver = parse_version(expected_version)

        # Floor versioning semantics
        if operator == '>=':
            if installed_ver < expected_ver:
                return (False, f"Version {installed_version} does not meet requirement >={expected_version}")
        elif operator == '==':
            if installed_ver != expected_ver:
                return (False, f"Version {installed_version} does not match required =={expected_version}")
        elif operator == '>':
            if installed_ver <= expected_ver:
                return (False, f"Version {installed_version} does not meet requirement >{expected_version}")
        elif operator == '<=':
            if installed_ver > expected_ver:
                return (False, f"Version {installed_version} exceeds maximum <={expected_version}")

    except Exception as e:
        return (True, f"Could not verify version: {e}")

    # Hash validation (LOOSENED - WARN ONLY)
    if package_name not in PACKAGE_HASHES or not PACKAGE_HASHES.get(package_name):
        # No hash defined - allow with info message
        return (True, None)

    # If hashes exist but we're in loosened mode, just return success
    # Real hash validation would go here, but we warn instead of block
    return (True, None)


def _check_installed_packages(parsed_requirements, mode='device'):
    """
    Check which packages are missing or need updates.

    Args:
        parsed_requirements (dict): Output from _parse_requirements_txt()
        mode (str): Monitoring mode ('device' or 'network')

    Returns:
        dict: Status of all packages categorized by type and issue
    """
    try:
        import importlib.metadata
    except ImportError:
        # Python < 3.8 fallback
        try:
            import importlib_metadata
            import importlib
            importlib.metadata = importlib_metadata
        except ImportError:
            return {
                'missing_critical': parsed_requirements['critical'],
                'missing_optional': parsed_requirements['optional'],
                'outdated_critical': [],
                'outdated_optional': [],
                'invalid_critical': [],
                'invalid_optional': []
            }

    result = {
        'missing_critical': [],
        'missing_optional': [],
        'outdated_critical': [],
        'outdated_optional': [],
        'invalid_critical': [],
        'invalid_optional': []
    }

    # MODE-AWARE: Scapy is only required for network mode
    # In device mode, scapy should be treated as optional
    mode_optional_packages = {'scapy'} if mode == 'device' else set()

    # Check critical packages
    for package_name, required_version, operator in parsed_requirements['critical']:
        # Skip packages that are optional for this mode
        if package_name in mode_optional_packages:
            # Move to optional checking
            result['missing_optional'].append((package_name, required_version, operator))
            continue

        try:
            installed_version = importlib.metadata.version(package_name)

            # Validate integrity
            is_valid, error_msg = _check_package_integrity(
                package_name, installed_version, required_version, operator
            )

            if not is_valid:
                if "does not meet requirement" in error_msg or "does not match" in error_msg:
                    result['outdated_critical'].append(
                        (package_name, installed_version, required_version, operator)
                    )
                else:
                    result['invalid_critical'].append((package_name, error_msg))

        except Exception:  # PackageNotFoundError or others
            result['missing_critical'].append((package_name, required_version, operator))

    # Check optional packages
    for package_name, required_version, operator in parsed_requirements['optional']:
        try:
            installed_version = importlib.metadata.version(package_name)

            is_valid, error_msg = _check_package_integrity(
                package_name, installed_version, required_version, operator
            )

            if not is_valid:
                if "does not meet requirement" in error_msg or "does not match" in error_msg:
                    result['outdated_optional'].append(
                        (package_name, installed_version, required_version, operator)
                    )
                else:
                    result['invalid_optional'].append((package_name, error_msg))

        except Exception:
            result['missing_optional'].append((package_name, required_version, operator))

    return result


